# PostgreSQL
PG_PASSWORD=change-me-pg

# RabbitMQ
RABBITMQ_PASSWORD=change-me-mq

# LLM (SiliconFlow / OpenAI 兼容)
SILICONFLOW_API_KEY=sk-your-key-here

# JWT 签名密钥(任意 >=32 字符随机串)
JWT_SECRET=please-replace-with-a-long-random-string-at-least-32-chars

# 管理员账号(可选,默认 admin / admin123)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 说明:首次部署用 docker-compose.yml 里默认的 SPRING_JPA_HIBERNATE_DDL_AUTO=update
# 让 Hibernate 自动建表。数据结构稳定后可改成 validate(在 compose 里改即可)。
